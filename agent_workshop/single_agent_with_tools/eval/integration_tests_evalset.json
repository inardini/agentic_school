{
    "eval_set_id": "developer_assistant_integration_tests",
    "name": "Developer Assistant Integration Tests",
    "description": "Integration tests for complex multi-turn conversations using ArXiv search, web scraping, Reddit search, and JSON validation",
    "eval_cases": [
      {
        "eval_id": "research_workflow",
        "conversation": [
          {
            "invocation_id": "int-001-1",
            "user_content": {
              "parts": [
                {
                  "text": "I'm researching neural networks. First, find academic papers about neural network optimization."
                }
              ],
              "role": "user"
            },
            "final_response": {
              "parts": [
                {
                  "text": "I'll search for academic papers about neural network optimization on ArXiv."
                }
              ],
              "role": "model"
            },
            "intermediate_data": {
              "tool_uses": [
                {
                  "name": "arxiv_search",
                  "args": {
                    "query": "neural network optimization"
                  }
                }
              ],
              "intermediate_responses": []
            }
          },
          {
            "invocation_id": "int-001-2",
            "user_content": {
              "parts": [
                {
                  "text": "Now check what developers are saying about neural networks on Reddit."
                }
              ],
              "role": "user"
            },
            "final_response": {
              "parts": [
                {
                  "text": "I'll search Reddit for developer discussions about neural networks."
                }
              ],
              "role": "model"
            },
            "intermediate_data": {
              "tool_uses": [
                {
                  "name": "mcp_reddit_tool",
                  "args": {
                    "query": "neural networks"
                  }
                }
              ],
              "intermediate_responses": []
            }
          },
          {
            "invocation_id": "int-001-3",
            "user_content": {
              "parts": [
                {
                  "text": "Finally, validate this neural network config JSON: {\"architecture\": \"CNN\", \"layers\": [32, 64, 128], \"activation\": \"relu\", \"dropout\": 0.2}"
                }
              ],
              "role": "user"
            },
            "final_response": {
              "parts": [
                {
                  "text": "The neural network configuration JSON is valid! The structure looks good for a CNN architecture."
                }
              ],
              "role": "model"
            },
            "intermediate_data": {
              "tool_uses": [
                {
                  "name": "json_validator",
                  "args": {
                    "json_string": "{\"architecture\": \"CNN\", \"layers\": [32, 64, 128], \"activation\": \"relu\", \"dropout\": 0.2}"
                  }
                }
              ],
              "intermediate_responses": []
            }
          }
        ],
        "session_input": {
          "app_name": "developer_assistant",
          "user_id": "test_user",
          "state": {}
        }
      },
