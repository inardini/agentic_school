              "role": "model"
            },
            "intermediate_data": {
              "tool_uses": [
                {
                  "name": "WebScraper",
                  "args": {
                    "url": "https://realpython.com"
                  }
                }
              ],
              "intermediate_responses": []
            }
          }
        ],
        "session_input": {
          "app_name": "developer_assistant",
          "user_id": "test_user",
          "state": {}
        }
      },
      {
